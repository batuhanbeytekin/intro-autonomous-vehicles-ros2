<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dimensions -->
  <xacro:property name="chassis_length" value="0.52"/>
  <xacro:property name="chassis_width"  value="0.34"/>
  <xacro:property name="chassis_height" value="0.14"/>

  <xacro:property name="wheel_radius" value="0.11"/>
  <xacro:property name="wheel_width"  value="0.06"/>
  <xacro:property name="wheel_y_offset" value="0.24"/>

  <xacro:property name="camera_box_x" value="0.06"/>
  <xacro:property name="camera_box_y" value="0.08"/>
  <xacro:property name="camera_box_z" value="0.05"/>

  <xacro:property name="laser_box_x" value="0.05"/>
  <xacro:property name="laser_box_y" value="0.05"/>
  <xacro:property name="laser_box_z" value="0.04"/>

  <xacro:property name="caster_radius" value="0.04"/>

  <xacro:property name="wheel_x_offset" value="0.06"/>
  <xacro:property name="caster_x_offset" value="-0.22"/>

  <!-- Masses -->
  <xacro:property name="base_mass" value="12.0"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="caster_mass" value="0.4"/>
  <xacro:property name="sensor_mass" value="0.2"/>

  <material name="body_blue">
    <color rgba="0.10 0.25 0.65 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <material name="sensor_gray">
    <color rgba="0.70 0.70 0.70 1.0"/>
  </material>

  <material name="caster_gray">
    <color rgba="0.40 0.40 0.40 1.0"/>
  </material>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(m/12.0) * (y*y + z*z)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(m/12.0) * (x*x + z*z)}"
        iyz="0.0"
        izz="${(m/12.0) * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r l">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${(m/12.0) * (3*r*r + l*l)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(m/12.0) * (3*r*r + l*l)}"
        iyz="0.0"
        izz="${0.5 * m * r * r}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius + chassis_height/2.0}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="body_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="${base_mass}"
      x="${chassis_length}"
      y="${chassis_width}"
      z="${chassis_height}"/>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia
      m="${wheel_mass}"
      r="${wheel_radius}"
      l="${wheel_width}"/>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${-chassis_height/2.0}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="${pi/2.0} 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertia
      m="${wheel_mass}"
      r="${wheel_radius}"
      l="${wheel_width}"/>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${wheel_x_offset} ${-wheel_y_offset} ${-chassis_height/2.0}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="${caster_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x_offset} 0 ${-(chassis_height/2.0 + wheel_radius - caster_radius)}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="${camera_box_x} ${camera_box_y} ${camera_box_z}"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="${camera_box_x} ${camera_box_y} ${camera_box_z}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="${sensor_mass}"
      x="${camera_box_x}"
      y="${camera_box_y}"
      z="${camera_box_z}"/>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.20 0 0.10" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="${-pi/2.0} 0 ${-pi/2.0}"/>
  </joint>

  <link name="laser_link">
    <visual>
      <geometry>
        <box size="${laser_box_x} ${laser_box_y} ${laser_box_z}"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>

    <collision>
      <geometry>
        <box size="${laser_box_x} ${laser_box_y} ${laser_box_z}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="${sensor_mass}"
      x="${laser_box_x}"
      y="${laser_box_y}"
      z="${laser_box_z}"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="0.16 0 0.13" rpy="0 0 0"/>
  </joint>

  <xacro:include filename="$(find my_robot)/urdf/my_robot.gazebo"/>
  <xacro:my_robot_gazebo/>

</robot>