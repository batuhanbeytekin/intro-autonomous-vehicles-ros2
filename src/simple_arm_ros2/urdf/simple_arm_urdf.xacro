<?xml version="1.0"?>
<robot name="simple_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="controllers_file" default=""/>

  <xacro:property name="link1_len" value="0.6"/>
  <xacro:property name="link2_len" value="0.5"/>
  <xacro:property name="link_w" value="0.06"/>
  <xacro:property name="link_h" value="0.06"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 0.2 0.1"/>
      </geometry>
      <material name="blue">
        <color rgba="0.1 0.2 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 0.2 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="${link1_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link1_len} ${link_w} ${link_h}"/>
      </geometry>
      <material name="gray">
        <color rgba="0.7 0.7 0.7 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link1_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link1_len} ${link_w} ${link_h}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link1_len/2.0} 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.08"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="${link2_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_len} ${link_w} ${link_h}"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.7 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link2_len/2.0} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_len} ${link_w} ${link_h}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link2_len/2.0} 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="${link1_len} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="2.0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.06 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="link_2"/>
    <child link="camera_link"/>
    <origin xyz="${link2_len} 0 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
      <parameters>$(arg controllers_file)</parameters>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="rgb_camera_sensor" type="camera">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>20.0</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>50.0</far>
        </clip>
      </camera>
      <plugin name="rgb_camera_controller" filename="libgazebo_ros_camera.so">
        <frame_name>camera_optical_link</frame_name>
        <camera_name>rgb_camera</camera_name>
      </plugin>
    </sensor>
  </gazebo>

</robot>